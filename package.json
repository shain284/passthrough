{
  "name": "passthrough",
  "version": "0.2.1",
  "description": "Save YouTube and TikTok videos as MP4 or MP3 without re-encoding the video stream",
  "main": "./out/main/index.js",
  "author": "shain284",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "npm run typecheck && electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --test test/integration.ts",
    "binaries": "node scripts/fetch-binaries.mjs",
    "icon": "node scripts/make-icon.mjs",
    "pack:win": "npm run build && electron-builder --win --publish never",
    "pack:dir": "npm run build && electron-builder --dir --publish never"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.3.1",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.2",
    "vite": "^5.4.11"
  }
}
